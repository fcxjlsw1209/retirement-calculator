# Environment: local | gcp
APP_ENV=local

# Data directory (local default: ~/.retirement-calculator/, GCP: /mnt/data/retirement-calculator)
# DATA_DIR=/mnt/data/retirement-calculator

# Empower credentials
EMPOWER_EMAIL=your@email.com
EMPOWER_PASSWORD=yourpassword

# Claude API (optional: enables AI attribution analysis)
ANTHROPIC_API_KEY=sk-ant-...

# Benchmark (default: 60% SPY / 40% AGG)
# BENCHMARK_TICKERS=SPY:0.6,AGG:0.4
